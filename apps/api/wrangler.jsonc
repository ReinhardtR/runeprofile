{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runeprofile-api",
  "main": "src/index.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "compatibility_date": "2025-03-01",
  "placement": {
    "region": "aws:us-east-1"
  },
  // Daily sweep of pending usernames whose holder has gone stale
  // (src/lib/profiles/sweep-stale-names.ts via the scheduled handler).
  "triggers": {
    "crons": ["15 4 * * *"]
  },
  "routes": [
    {
      "pattern": "api.runeprofile.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      // One stored event per invocation is ~6M events/day of plugin polls.
      // The wide event (src/lib/logging.ts) is the canonical per-request
      // record: errors/slow/writes always, fast reads tail-sampled.
      "invocation_logs": false,
    },
  },
  // Not a secret: a zone id identifies the zone, it does not authorise
  // anything. The token that goes with it is a secret, set with
  // `wrangler secret put CLOUDFLARE_API_TOKEN`.
  "vars": {
    "CLOUDFLARE_ZONE_ID": "d650f3f90dabac1b3c98ed0c309346b9",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "411e7ad012ac4dc99be2e779457e87fb",
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "runeprofile-player-models",
      "preview_bucket_name": "runeprofile-player-models",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "c6de4480edb14f219ff7457341829941",
      "preview_id": "c6de4480edb14f219ff7457341829941"
    }
  ],
  "ratelimits": [
    {
      "name": "V1_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "V1_RATE_LIMIT_KEYED",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "V1_RATE_LIMIT_PARTNER",
      "namespace_id": "1003",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      // Per-IP limit for the internal profile search endpoint. Generous
      // enough for a human typing in the search box (fires per keystroke),
      // tight enough that it can't be used to hammer the database.
      "name": "SEARCH_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}